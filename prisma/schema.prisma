generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RequestStatus {
  new
  processing
  done
}

enum RequestSource {
  public
  admin
}

enum AdminRole {
  owner
  admin
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         AdminRole @default(admin)
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       AdminUser @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  entity      String
  entityId    String?
  ip          String
  userAgent   String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([userId])
}

model AdminRequest {
  id        String        @id @default(cuid())
  name      String
  whatsapp  String
  email     String
  service   String
  notes     String
  adminNotes String?      @db.Text
  status    RequestStatus @default(new)
  source    RequestSource @default(public)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AdminService {
  id        String   @id @default(cuid())
  name      String
  description String
  tagline   String?
  highlight String?
  icon      String
  estimasi  String
  color     String
  features  Json?
  previewFeatures Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminPricing {
  id          String   @id @default(cuid())
  name        String
  price       String
  description String
  features    Json
  notIncluded Json?
  badge       String
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminPricingComparisonRow {
  id        String   @id @default(cuid())
  feature   String
  values    Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([createdAt])
}

model AdminTestimonial {
  id          String   @id @default(cuid())
  name        String
  institution String
  role        String
  comment     String
  rating      Int
  journal     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminTestimonialImage {
  id        String   @id @default(cuid())
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model AdminFaq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @default("general")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([sortOrder])
}

model AdminBlog {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String?  @db.LongText
  category  String
  date      DateTime @db.Date
  readTime  String
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  image     String?
  author    String?
  authorRole String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([date])
}

model SiteSettings {
  id           String   @id @default("singleton")
  brand        String
  whatsapp     String
  email        String
  instagram    String
  tagline      String
  hoursWeekday String   @default("08.00 - 17.00 WIB")
  hoursWeekend String   @default("09.00 - 15.00 WIB")
  hoursHoliday String   @default("Tutup (WA 24/7)")
  hoursNote    String   @default("WhatsApp tersedia 24/7. Pesan di luar jam kerja akan direspons pada hari kerja berikutnya.")
  location     String   @default("Indonesia (Remote Service)")
  reach        String   @default("Seluruh Indonesia & Internasional")
  updatedAt    DateTime @updatedAt
}

model SiteAbout {
  id        String   @id @default("singleton")
  data      Json
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model SiteHero {
  id               String   @id @default("singleton")
  badge            String   @default("Platform Publikasi Jurnal #1 Indonesia")
  heading          String   @default("Permudah")
  headingHighlight String   @default("Publikasi")
  headingSuffix    String   @default("Jurnal Anda")
  description      String   @default("Syntara hadir sebagai mitra terpercaya dalam perjalanan publikasi jurnal ilmiah Anda. Dari editing hingga pendampingan submit — kami siap membantu dengan profesional.")
  ctaText          String   @default("Konsultasi Sekarang")
  ctaLink          String   @default("/api/wa?text=Halo%2C+saya+ingin+konsultasi")
  secondaryCtaText String   @default("Lihat Layanan")
  secondaryCtaLink String   @default("/layanan")
  image            String?  
  stat1Value       String   @default("500+")
  stat1Label       String   @default("Jurnal Dipublikasikan")
  stat2Label       String   @default("Klien Puas")
  stat3Value       String   @default("98%")
  stat3Label       String   @default("Tingkat Keberhasilan")
  stat4Value       String   @default("24/7")
  stat4Label       String   @default("Dukungan Tim")
  
  featuresBadge    String   @default("Mengapa Syntara?")
  featuresTitle    String   @default("Solusi Terbaik untuk Publikasi Jurnal Anda")
  featuresSubtitle String   @default("Kami menggabungkan keahlian akademik dengan teknologi modern untuk hasil publikasi yang maksimal")
  featuresItems    Json     @default("[{\"icon\":\"Zap\",\"title\":\"Proses Cepat\",\"desc\":\"Penyelesaian dalam 3-7 hari kerja dengan kualitas terjamin\"},{\"icon\":\"Shield\",\"title\":\"Harga Terjangkau\",\"desc\":\"Paket mulai dari harga yang ramah di kantong mahasiswa\"},{\"icon\":\"Users\",\"title\":\"Pendampingan Intensif\",\"desc\":\"Tim ahli siap membantu dari awal hingga jurnal diterima\"},{\"icon\":\"TrendingUp\",\"title\":\"Tingkat Keberhasilan Tinggi\",\"desc\":\"Lebih dari 500+ jurnal berhasil dipublikasikan\"}]")
  
  updatedAt        DateTime @updatedAt
}
